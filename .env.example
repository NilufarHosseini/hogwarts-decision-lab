AZURE_OPENAI_ENDPOINT=https://foundrynh.services.ai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-sol
AZURE_OPENAI_API_MODE=responses
AZURE_OPENAI_TOKEN_SCOPE=https://ai.azure.com/.default
# Fill pricing for your actual Azure model/region, otherwise displayed USD cost stays zero (unknown).
AZURE_INPUT_USD_PER_1M=0
AZURE_OUTPUT_USD_PER_1M=0
# JEV requires a real compatible MCP runtime; no fake JEV routing here.
JEV_MCP_URL=

# Local Kev server (start separately from the kev source repo)
KEV_BASE_URL=http://127.0.0.1:8009
KEV_MODEL=kev-latest
KEV_TIMEOUT_SECONDS=120
